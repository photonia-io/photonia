<% content_for(:page_title, @photo.title) %>
<% content_for(:canonical_url, photo_url(@photo)) %>
<% content_for(:meta_description, photo_meta_description(@photo, tags: @tags, rekognition_tags: @rekognition_tags)) %>
<% content_for(:structured_data, photo_structured_data(@photo)) %>
<div>
  <h1><%= @photo.title.presence || '(no title)' %></h1>
  <% if @photo.prev %>
    <div>
      <a href="<%= photo_path(@photo.prev) %>">
        Previous
        <img src="<%= @photo.prev.image_url(:thumbnail_intelligent).presence || @photo.prev.image_url(:thumbnail_square) %>" alt="<%= @photo.prev.title %>" loading="lazy">
      </a>
    </div>
  <% end %>
  <% if @photo.next %>
    <div>
      <a href="<%= photo_path(@photo.next) %>">
        <img src="<%= @photo.next.image_url(:thumbnail_intelligent).presence || @photo.next.image_url(:thumbnail_square) %>" alt="<%= @photo.next.title %>" loading="lazy">
        Next
      </a>
    </div>
  <% end %>
</div>
<hr>
<div>
  <div>
    <img src="<%= @photo.image_url(:large) %>" alt="<%= @photo.alt_text %>" loading="lazy" />
    <% if @photo.description_html.presence %>
      <h2>Description</h2>
      <div>
        <%= @photo.description_html.html_safe %>
      </div>
    <% end %>

    <h3>Date Taken</h3>
    <p><%= @photo.taken_at_text %></p>

    <h3>Date Posted</h3>
    <p><%= @photo.posted_at.strftime('%B %e, %Y') %></p>
  </div>
  <div>
    <% if @photo.albums.any? %>
      <h3>Albums</h3>
      <ul>
      <% @photo.albums.each do |album| %>
        <li>
          <h4><a href="<%= album_path(album) %>"><%= album.title %></a></h4>
          <div>
          <% if (prev_photo = @photo.prev_in_album(album)) %>
            <a href="<%= photo_path(prev_photo) %>">
              <img src="<%= prev_photo.image_url(:thumbnail_intelligent).presence || prev_photo.image_url(:thumbnail_square) %>" alt="<%= prev_photo.title %>" loading="lazy">
              Previous
            </a>
          <% end %>
        </div>
        <div>
          <% if (next_photo = @photo.next_in_album(album)) %>
            <a href="<%= photo_path(next_photo) %>">
              <img src="<%= next_photo.image_url(:thumbnail_intelligent).presence || next_photo.image_url(:thumbnail_square) %>" alt="<%= next_photo.title %>" loading="lazy">
              Next
            </a>
          <% end %>
          </div>
        </li>
      <% end %>
      </ul>
    <% end %>

    <h3>Comments</h3>
    <% top_level_comments = @photo.comments.select(&:top_level?) %>
    <% if top_level_comments.any? %>
      <ul>
        <% top_level_comments.each do |comment| %>
          <%= render 'comments/comment', comment: comment %>
        <% end %>
      </ul>
    <% else %>
      <p>No comments yet.</p>
    <% end %>

    <h3>Tags</h3>
    <div>
      <% @tags.each do |tag| %>
        <a href="<%= tag_path(tag) %>"><%= tag.name %></a>
      <% end %>
    </div>

    <h3>AI Tags</h3>
    <div>
      <% @rekognition_tags.each do |tag| %>
        <a href="<%= tag_path(tag) %>"><%= tag.name %></a>
      <% end %>
    </div>
  </div>
</div>
