<% page_suffix = (@pagy && @pagy.page != 1) ? " - Page #{@pagy.page}" : "" %>
<% content_for(:page_title, "Album: #{@album.title}#{page_suffix}") %>
<% content_for(:canonical_url, canonical_url(album_path(@album))) %>
<%
  album_description = @album.description.presence ?
    strip_tags(@album.description_html) :
    "Album: #{@album.title}. #{@album.public_photos_count} #{@album.public_photos_count == 1 ? 'photo' : 'photos'}."
%>
<% content_for(:meta_description, album_description) %>

<h1>Album: <%= @album.title %></h1>
<hr>
<% if @album.description.present? %>
  <div><%= @album.description_html %></div>
<% end %>

<div>
  <% (@photos || []).each do |photo| %>
    <div>
      <a href="<%= photo_path(photo) %>">
        <img src="<%= photo.image_url(:medium_intelligent).presence || photo.image_url(:medium_square) %>" alt="<%= photo.title %>" loading="lazy" />
        <%= photo.title %>
      </a>
    </div>
  <% end %>
</div>

<hr>

<%== pagy_bulma_nav(@pagy) if @pagy.present? %>
