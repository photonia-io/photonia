# Photonia environment variables. Copy to .env (and .env.development / .env.test
# for per-environment DATABASE_URL overrides) and fill in real values.
# dotenv-rails loads these automatically in development and test.

# Database - per environment, since DATABASE_URL would otherwise override every
# Rails env. Put these in .env.development / .env.test instead of here.
# DATABASE_URL=postgres://user:pass@host:5432

# Redis - shared by Sidekiq and (in production) Action Cable
REDIS_URL=redis://localhost:6379/0

# Image sizes in pixels, passed to libvips as integers
THUMBNAIL_SIDE=200
MEDIUM_SIDE=1600

# S3 / Shrine
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=

# AWS Rekognition - separate credential pair from S3
REKOGNITION_ACCESS_KEY_ID=
REKOGNITION_SECRET_ACCESS_KEY=

# Auth
DEVISE_JWT_SECRET_KEY=
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Flickr import
FLICKR_API_KEY=

# Mail (SES SMTP)
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
MAILER_FROM_NAME=Photonia
MAILER_FROM_ADDRESS=mailer@photonia.io

# Sidekiq web UI (/sidekiq) basic auth
SIDEKIQ_WEB_USERNAME=
SIDEKIQ_WEB_PASSWORD=

# Sentry - leave blank in development so dev errors are not reported
BE_SENTRY_DSN=
FE_SENTRY_DSN=
BE_SENTRY_SAMPLE_RATE=0.1
FE_SENTRY_SAMPLE_RATE=0.1

# Optional site setting default
TRACKING_CODE=
