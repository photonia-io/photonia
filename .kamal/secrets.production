# Secrets for `kamal deploy -d production`, fetched from 1Password.
# Requires: `op` installed and signed in, $OP_ACCOUNT exported in your shell.

SECRETS="$(kamal secrets fetch \
  --adapter 1password --account $OP_ACCOUNT --from Credentials/General \
  KAMAL_REGISTRY_PASSWORD \
)"
KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD ${SECRETS})

SECRETS="$(kamal secrets fetch \
  --adapter 1password --account $OP_ACCOUNT --from Credentials/Photonia \
  RAILS_MASTER_KEY \
  DATABASE_URL \
  REDIS_URL \
  DEVISE_JWT_SECRET_KEY \
  S3_ACCESS_KEY_ID \
  S3_SECRET_ACCESS_KEY \
  REKOGNITION_ACCESS_KEY_ID \
  REKOGNITION_SECRET_ACCESS_KEY \
  SES_SMTP_USERNAME \
  SES_SMTP_PASSWORD \
  BE_SENTRY_DSN \
  FE_SENTRY_DSN \
  SIDEKIQ_WEB_USERNAME \
  SIDEKIQ_WEB_PASSWORD \
  FLICKR_API_KEY \
  GOOGLE_CLIENT_ID \
  FACEBOOK_APP_ID \
  FACEBOOK_APP_SECRET \
)"

RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY ${SECRETS})
DATABASE_URL=$(kamal secrets extract DATABASE_URL ${SECRETS})
REDIS_URL=$(kamal secrets extract REDIS_URL ${SECRETS})
DEVISE_JWT_SECRET_KEY=$(kamal secrets extract DEVISE_JWT_SECRET_KEY ${SECRETS})
S3_ACCESS_KEY_ID=$(kamal secrets extract S3_ACCESS_KEY_ID ${SECRETS})
S3_SECRET_ACCESS_KEY=$(kamal secrets extract S3_SECRET_ACCESS_KEY ${SECRETS})
REKOGNITION_ACCESS_KEY_ID=$(kamal secrets extract REKOGNITION_ACCESS_KEY_ID ${SECRETS})
REKOGNITION_SECRET_ACCESS_KEY=$(kamal secrets extract REKOGNITION_SECRET_ACCESS_KEY ${SECRETS})
SES_SMTP_USERNAME=$(kamal secrets extract SES_SMTP_USERNAME ${SECRETS})
SES_SMTP_PASSWORD=$(kamal secrets extract SES_SMTP_PASSWORD ${SECRETS})
BE_SENTRY_DSN=$(kamal secrets extract BE_SENTRY_DSN ${SECRETS})
FE_SENTRY_DSN=$(kamal secrets extract FE_SENTRY_DSN ${SECRETS})
SIDEKIQ_WEB_USERNAME=$(kamal secrets extract SIDEKIQ_WEB_USERNAME ${SECRETS})
SIDEKIQ_WEB_PASSWORD=$(kamal secrets extract SIDEKIQ_WEB_PASSWORD ${SECRETS})
FLICKR_API_KEY=$(kamal secrets extract FLICKR_API_KEY ${SECRETS})
GOOGLE_CLIENT_ID=$(kamal secrets extract GOOGLE_CLIENT_ID ${SECRETS})
FACEBOOK_APP_ID=$(kamal secrets extract FACEBOOK_APP_ID ${SECRETS})
FACEBOOK_APP_SECRET=$(kamal secrets extract FACEBOOK_APP_SECRET ${SECRETS})
